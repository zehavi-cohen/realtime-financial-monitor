{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Information",
      "Microsoft.AspNetCore.Http.Connections": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Storage": {
    "Mode": "InMemory"
  },

  "HotWindow": {
    "Size": 500,
    "Ttl": "24:00:00",
    "RebuildLockDuration": "00:00:10",
    "RebuildWait": "00:00:00.150",
    "RebuildWaitAttempts": 5
  },

  "SqlServer": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 15,
    "StartupTimeout": "00:02:00"
  },

  "Redis": {
    "ConnectionString": "",
    "ChannelPrefix": "rtfm"
  },

  "Resilience": {
    "MaxRetryAttempts": 3,
    "BaseDelay": "00:00:00.200"
  },

  "Cors": {
    "AllowedOrigins": []
  }
}
